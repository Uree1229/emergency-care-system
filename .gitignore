# Python
__pycache__/
*.pyc
.venv/
venv/

# 벤더링된 솔버 라이브러리 (requirements-portable.txt로 설치)
.solver_deps/
.codex-build/

# 문서 렌더링 점검용 이미지·PDF
.docx_qa*/

# USB 이동·백업 산출물
.usb_export/
usb_import_backups/
*.zip

# Word 임시 파일
~$*

# 비밀값
.env
.env.*

# 개인용 에이전트 설정
.claude/

# 이전 위치의 열려 있는 Word 파일과 USB 전송 목록
/캡스톤_전체구현기능_롱리스트.docx
/TRANSFER_MANIFEST.json

# 서버 실행 DB·API 수집 원본
data/

# 초기 환자 앱의 로컬 실행 DB (구형 업로드 DB를 다시 추적하지 않음)
/emergency-app/*.db
/emergency-app/*.db-wal
/emergency-app/*.db-shm

# 도로 snapshot은 재현용으로 보관하되 수집 잠금·실행 시각은 제외
simulation/route_cache/.request_lock/
simulation/route_cache/.last_request.json
simulation/route_cache/*.tmp

# 실험 결과 원본(JSON)과 사례별 압축 기록(*_cases/*.json.gz)은 크기가 커서(합계 약 6GB) 외부에 백업한다.
# 보고서(.md)와 잠금 파일(*_lock.json)만 커밋한다. 이미 추적 중인 작은 JSON은 그대로 둔다.
simulation_results/**/*.json
simulation_results/**/*.json.gz
!simulation_results/**/*_lock.json
# 지도 재생용 대용량 생성 데이터(약 128MB)
simulation/viewer/map_replay_data.json
# 발표 파일·DB 덤프·행정 문서 등 개인 작업 산출물
outputs/

# 팀원 앱 실행 DB와 로컬 미리보기
/emergency-app/*.db
/emergency-app/*.db-*
/emergency-app/*.sqlite*
.local-preview/
